        <field>date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Date Validator</name>
        <order/>
        <script><![CDATA[function onSubmit() {

    if (g_scratchpad.validated) {
        return true; 
    }
    

    var courseId = g_form.getValue('course'); 
    var proposedDate = g_form.getValue('date'); 
    var sysId = g_form.getUniqueValue(); 


    if (!courseId || !proposedDate) {
        return true; 
    }
    

    var ga = new GlideAjax('TrainingDateValidator'); 
    ga.addParam('sysparm_name', 'checkDuplicateDate'); 
    ga.addParam('sysparm_course', courseId);
    ga.addParam('sysparm_date', proposedDate);
    ga.addParam('sysparm_sys_id', sysId); 


    ga.getXMLAnswer(validateResponse);
    

    return false; 
}


function validateResponse(answer) {
    var result;
    

    try {
        result = JSON.parse(answer);
    } catch (e) {

        console.error("Error parsing response from server: " + e.message); 
        g_form.addErrorMessage("Internal server error during validation. Please try again.");
        return; 
    }
    
    if (result.conflict) {

        var msg = "ERROR: The training for '" + result.courseName + 
                  "' is already scheduled for " + result.date + 
                  ". Please change the date.";
        
        g_form.addErrorMessage(msg);
        
    } else {

        g_scratchpad.validated = true;
        g_form.submit();
    }
}]]></script>
