        <messages/>
        <name>Duplicate Date on Submit</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var course = g_form.getValue('course');
    var date   = g_form.getValue('date'); 

    if (!course || !date) return true; 

    var ga = new GlideAjax('CheckScheduleDuplicate');
    ga.addParam('sysparm_name', 'isDuplicate');
    ga.addParam('sysparm_course_id', course);
    ga.addParam('sysparm_date_id', date);

    var answer = ga.getXMLWait();
    if (answer === 'true') {
        g_form.showFieldMsg('date', 'already exist.', 'error');
        return false; 
    }

    return true; 
}
]]></script>
