    <sys_script_client action="DELETE">
        <active>false</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description/>
        <field>date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Duplicate Date</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var course = g_form.getValue('course');
    var date = g_form.getValue('date');

    var ga = new GlideAjax('AvoidDuplicateCourse');
    ga.addParam('sysparm_name', 'isDuplicate');
    ga.addParam('sysparm_course', course);
    ga.addParam('sysparm_date', date);

    ga.getXMLAnswer(function(answer) {
        if (answer === 'true') {
            g_form.addErrorMessage('ERROR: Unable to schedule. A training for this course already exists on this date.');
            g_form.showFieldMsg('date', 'Date already scheduled for this course.', 'error');
            g_form.setValue('date', ''); 
        } else {
            g_form.clearMessages();
        }
    });
}
]]></script>
