        <description/>
        <mobile_callable>false</mobile_callable>
        <name>TrainingDateValidator</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingDateValidator = Class.create();
TrainingDateValidator.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    checkDuplicateDate: function() {
        var proposedDate = this.getParameter('sysparm_date');
        var courseId = this.getParameter('sysparm_course');
        var sysId = this.getParameter('sysparm_sys_id'); 

        var gr = new GlideRecord("x_752538_course_schedule"); 

        gr.addQuery('date', proposedDate);
        gr.addQuery('course', courseId);

        if (sysId) {
            gr.addQuery('sys_id', '!=', sysId);
        }

        gr.setLimit(1);
        gr.query();

        if (gr.next()) {

            var result = {};
            result.conflict = true;
            result.courseName = gr.course.getDisplayValue();
            result.date = gr.date.getDisplayValue();
            return JSON.stringify(result);
        }

    
        return JSON.stringify({
            conflict: false
        });
    },

    type: 'TrainingDateValidator'
});]]></script>
