<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_email">
    <sys_script_email action="INSERT_OR_UPDATE">
        <name>show_enrolled_list</name>
        <new_lines_to_html>false</new_lines_to_html>
        <script><![CDATA[(function runMailScript(current, template, email, email_action, event) {

    var enrollmentGR = new GlideRecord('x_752538_course_enrollment');
    enrollmentGR.addQuery('date', current.sys_id);
    enrollmentGR.query();

    template.print('<p><b>Enrollment list: ' + current.course.name + '</b></p>');
    template.print('<ul>');

    while (enrollmentGR.next()) {
        template.print('<li>' + enrollmentGR.opened_by.getDisplayValue() + '</li>');;
    }

    template.print('</ul>');

})(current, template, email, email_action, event);
]]></script>
