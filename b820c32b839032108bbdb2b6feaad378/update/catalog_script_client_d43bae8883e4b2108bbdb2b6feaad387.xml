        <name>ValidateEnrollment </name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) return;

    var openedBy = g_user.userID;
    var dateId = newValue;

    var ga = new GlideAjax('CheckEnrollment');
    ga.addParam('sysparm_name', 'isAlreadyEnrolled');
    ga.addParam('sysparm_opened_by', openedBy);
    ga.addParam('sysparm_date_id', dateId);

    ga.getXMLAnswer(function(answer) {
        if (answer === 'true') {
			g_form.clearValue('date');
            g_form.showFieldMsg('date', 'You already have an enrollment to this course.', 'error');
        } else {
            g_form.hideFieldMsg('date');
        }
    });
}]]></script>
