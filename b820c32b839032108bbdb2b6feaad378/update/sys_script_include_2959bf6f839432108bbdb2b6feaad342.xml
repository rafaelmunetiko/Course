        <name>InstructorFilter</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var InstructorFilter = Class.create();
InstructorFilter.prototype = {
	
    getInstructor: function(current) {

        var courseSysId = current.course;

        if (gs.nil(courseSysId)) {
            return 'sys_id=NULL';
        }

        var course = new GlideRecord('x_752538_course_course');

        if (course.get(courseSysId)) {

            var instructorSysId = course.instructor.toString();

            if (gs.nil(instructorSysId)) {
                return 'sys_id=NULL';
            }

            return 'sys_id=' + instructorSysId;

        }

        return 'sys_id=NULL';

    },

    type: 'InstructorFilter'
};]]></script>
