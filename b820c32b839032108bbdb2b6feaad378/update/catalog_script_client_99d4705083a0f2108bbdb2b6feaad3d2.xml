        <name>Limit Enrollment</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || !newValue) return;

    var openedBy = g_user.userID;
    var courseId = g_form.getValue('course');

    if (!courseId) return;

    var ga = new GlideAjax('CheckCourseEnrollmentLimit');
    ga.addParam('sysparm_name', 'hasReachedLimit');
    ga.addParam('sysparm_opened_by', openedBy);
    ga.addParam('sysparm_course_id', courseId);

    ga.getXMLAnswer(function(answer) {
        if (answer === 'true') {
            g_form.clearValue('course');
            g_form.showFieldMsg('course', 'Already done 3 times this course.', 'error');
        } else {
            g_form.hideFieldMsg('course');
        }
    });
}]]></script>
