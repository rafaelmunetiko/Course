        <name>Validate Instructor</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') {
        return;
    }

    var currentUser = g_user.userID;

    g_form.getReference('course', function(course) {
        if (course.instructor == currentUser) {
            g_form.clearValue('course');
            g_form.showFieldMsg('course', 'You can not enroll on your own course.', 'error');
        } else {
            g_form.hideFieldMsg('course');
        }
    });
}]]></script>
