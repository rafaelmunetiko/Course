        <script><![CDATA[var AvoidDuplicateCourse = Class.create();
AvoidDuplicateCourse.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    isDuplicate: function() {
        var date = this.getParameter('sysparm_date');
        var course = this.getParameter('sysparm_course');

		var gr = new GlideRecord('x_752538_course_schedule');

		gr.addQuery('course', course);
		gr.addQuery('date', date);
		
		gr.query();

		if (gr.next()) {
            return 'true'; 
        }

        return 'false';
    }
	
});]]></script>
